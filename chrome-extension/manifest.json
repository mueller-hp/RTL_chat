{
  "manifest_version": 3,
  "name": "RTL for Claude",
  "version": "0.2.0",
  "description": "Readable Hebrew on claude.ai: each paragraph picks its own direction, code stays left to right. Ctrl+Alt+R toggles.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RTL for Claude",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["rtl-mod.js"],
      "run_at": "document_idle"
    }
  ]
}
